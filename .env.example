# Pilih salah satu provider AI Vision untuk mode otonom penuh (bisa juga diisi langsung lewat menu ⚙️ di Web UI)
# Provider yang didukung: gemini | openai | anthropic | openrouter

LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=

# Opsional: Custom Base URL jika pakai OpenRouter / Ollama / Groq / DeepSeek
# Contoh OpenRouter: https://openrouter.ai/api/v1
# Contoh Ollama lokal: http://localhost:11434/v1
LLM_BASE_URL=

# Konfigurasi Server & Browser Sandbox
PORT=8000
BROWSER_PROFILE_DIR=/tmp/nusa_operator_profile
WORKSPACE_DIR=./workspace_files
